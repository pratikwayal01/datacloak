{
  "manifest_version": 3,
  "name": "DataCloak",
  "version": "0.3.0",
  "description": "Swap secrets/PII for realistic fakes before AI chat sees them.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting", "contextMenus"],
  "optional_host_permissions": ["<all_urls>"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://x.ai/*",
    "https://www.perplexity.ai/*",
    "https://cowork.ai/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "scripts": ["dist/background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "myextension@myname.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://x.ai/*",
        "https://www.perplexity.ai/*",
        "https://cowork.ai/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DataCloak",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
