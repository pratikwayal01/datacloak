{
  "name": "@pratikw/vscode-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/extension.js",
  "engines": { "vscode": "^1.90.0" },
  "scripts": { "build": "tsc", "test": "vitest run" },
  "dependencies": { "@pratikw/detect": "*" },
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "datacloak", "title": "DataCloak", "icon": "resources/datacloak.svg" }] },
    "views": { "datacloak": [{ "id": "datacloak.vault", "name": "Vault" }] },
    "commands": [
      { "command": "datacloak.cloakSelection", "title": "DataCloak: Cloak selection" },
      { "command": "datacloak.restoreSelection", "title": "DataCloak: Restore selection" },
      { "command": "datacloak.reveal", "title": "DataCloak: Reveal value" }
    ],
    "activationEvents": ["onStartupFinished"]
  },
  "devDependencies": { "@types/vscode": "^1.90.0", "typescript": "~5.6.3", "vitest": "^3.0.0" }
}
